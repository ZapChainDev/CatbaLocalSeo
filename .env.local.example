# Required — get these from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — used for sitemap generation and canonical URLs
NEXT_PUBLIC_SITE_URL=https://catba-local-seo.vercel.app

# Admin dashboard password — keep this secret, never commit the real value
ADMIN_SECRET=choose-a-strong-password-here
